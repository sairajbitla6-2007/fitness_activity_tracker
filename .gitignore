# Local configuration and secrets
.env
.env.*
!.env.example
workspace/.env
workspace/.env.*
!workspace/.env.example
!workspace/apps/mobile/.env.example

# Local project instructions and context
AGENTS.md
PROJECT_CONTEXT.md

# Dependencies, generated builds, and IDE state
**/node_modules/
