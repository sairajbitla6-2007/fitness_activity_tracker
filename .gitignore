*.log
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Publish only screenshots without personal account details
workspace/screenshots/*
!workspace/screenshots/register page.jpeg
!workspace/screenshots/reset password.jpeg
!workspace/screenshots/login-page-public.jpeg
