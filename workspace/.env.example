# Copy to .env for local development. Replace the example values locally.
API_PORT=3000
# Bind to LAN interfaces so a physical development phone can reach the API.
API_HOST=0.0.0.0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fitness_tracker
MYSQL_USER=fitness_app
MYSQL_PASSWORD=local_dev_only_change_me
AUTH_ACCESS_TOKEN_SECRET=
API_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# SMTP 465 uses implicit TLS. For port 587, use SMTP_SECURE=false with STARTTLS required.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
PASSWORD_RESET_APP_SCHEME=fitness-tracker
